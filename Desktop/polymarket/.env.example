# Copy to .env and fill in your values.
# This template is safe to share and contains no working secrets.

# Telegram bot
BOT_TOKEN=your_telegram_bot_token_here
ADMIN_CHAT_ID=0
DATABASE_PATH=polymarket.db

# Telegram listener (optional, only if you use listener.py)
TG_API_ID=your_telegram_api_id_here
TG_API_HASH=your_telegram_api_hash_here
LISTEN_CHANNEL=PolyInsiderAlerts

# Polymarket CLOB wallet
POLY_FUNDER_ADDRESS=0xyour_wallet_address_here
POLY_PRIVATE_KEY=0xyour_private_key_here
POLY_API_KEY=your_api_key_here
POLY_SECRET=your_secret_here
POLY_PASSPHRASE=your_passphrase_here
POLY_SIGNATURE_TYPE=0

# Copy trader settings
COPY_NOTIONAL_USD=1.05
MIN_ORDER_SIZE=5.5
MIN_SELL_ORDER_SIZE=0
MIN_ORDER_NOTIONAL=1
BALANCE_BUFFER_USD=0.50
RESERVE_CASH_USD=0
COPY_SELLS=1
SELL_ONLY_IN_PROFIT=1
POLL_INTERVAL_SEC=30
ORDER_COOLDOWN_SEC=180
ORDER_FILL_WAIT_SEC=90
COPY_ORDER_TYPE=GTC
RECENT_TRADES_LIMIT=5
BACKFILL_RECENT_TRADES=0
FETCH_TIMEOUT_SEC=5
FETCH_RETRIES=1
HEARTBEAT_SEC=60
SEEN_TRADES_MAX=2000
HTTP_BACKOFF_SEC=0.75

# Optional filters
WATCH_ONLY_WALLET=
SHORT_TERM_WALLET=
SHORT_TERM_MIN_PRICE=0.05
SHORT_TERM_MAX_PRICE=0.20
COPY_ALL_SHORT_TERM_FOR_WALLET=0
ALLOWED_MARKET_KEYWORDS=

# Take-profit
TAKE_PROFIT_ENABLE=1
TAKE_PROFIT_TRIGGER_PCT=0.20
TAKE_PROFIT_LOCK_PCT=0.10
TAKE_PROFIT_CHECK_SEC=20
TAKE_PROFIT_MAX_PER_CHECK=2
TAKE_PROFIT_DRY_RUN=0
AUTO_SELL_AFTER_BUY_ENABLE=0
AUTO_SELL_AFTER_BUY_PRICE=0.50
AUTO_SELL_AFTER_BUY_DELAY_SEC=3

# Profit-take
PROFIT_TAKE_ENABLE=1
PROFIT_TAKE_USD=30
PROFIT_TAKE_CHECK_SEC=10
PROFIT_TAKE_MAX_PER_CHECK=1
PROFIT_TAKE_DRY_RUN=0
LOW_ENTRY_TAKE_PROFIT_ENABLE=1
LOW_ENTRY_TAKE_PROFIT_USD=20
LOW_ENTRY_MIN_AVG=0.10
LOW_ENTRY_MAX_AVG=0.30
